{
  "name": "the-stands-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint -w apps/web",
    "sync:once": "npm run once -w services/fixtures-sync",
    "sync:worker": "npm run start -w services/fixtures-sync",
    "mobile:sync": "cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "notifier:once": "npm run once -w services/notifier",
    "notifier:worker": "npm run start -w services/notifier",
    "trends:once": "npm run once -w services/trends",
    "trends:worker": "npm run start -w services/trends"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2"
  }
}